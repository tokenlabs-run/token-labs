{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "dynamo-ray-startup-validation"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "ray-head",
        "namespace": "dynamo-ray-startup-validation"
      },
      "spec": {
        "selector": {
          "app": "ray-head"
        },
        "ports": [
          {
            "port": 6379,
            "targetPort": 6379
          }
        ],
        "clusterIP": "None",
        "publishNotReadyAddresses": true
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "ray-worker-0",
        "namespace": "dynamo-ray-startup-validation",
        "labels": {
          "app": "ray-worker-0"
        }
      },
      "spec": {
        "nodeSelector": {
          "kubernetes.io/hostname": "spark-02"
        },
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "ray",
            "image": "docker.io/library/python@sha256:233de06753d30d120b1a3ce359d8d3be8bda78524cd8f520c99883bfe33964cf",
            "command": [
              "/bin/sh",
              "-c"
            ],
            "args": [
              "pip install --disable-pip-version-check --no-cache-dir \"ray==2.55.1\" > /tmp/ray-install.log 2>&1 || { cat /tmp/ray-install.log; exit 1; }; export LEADER_HOST=\"${LWS_LEADER_ADDRESS}\"; i=0; until python3 -c \"import os, socket; s=socket.create_connection((os.environ['LEADER_HOST'], 6379), timeout=2); s.close()\" 2>/dev/null; do i=$((i+1)); [ \"$i\" -ge 150 ] && { echo \"ERROR: Ray head did not become reachable after 150 attempts\" >&2; exit 1; }; echo \"Waiting for Ray head at $LEADER_HOST:6379...\"; sleep 2; done && ray start --address=\"$LEADER_HOST:6379\" --block"
            ],
            "env": [
              {
                "name": "LWS_LEADER_ADDRESS",
                "value": "ray-head"
              },
              {
                "name": "RAY_USAGE_STATS_ENABLED",
                "value": "0"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "500m",
                "memory": "1Gi"
              },
              "limits": {
                "cpu": "2",
                "memory": "3Gi"
              }
            },
            "volumeMounts": [
              {
                "name": "shm",
                "mountPath": "/dev/shm"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "shm",
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "512Mi"
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "ray-worker-1",
        "namespace": "dynamo-ray-startup-validation",
        "labels": {
