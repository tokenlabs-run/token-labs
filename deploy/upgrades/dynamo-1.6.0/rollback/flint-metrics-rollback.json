{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "flint-provider-metrics",
    "namespace": "token-labs",
    "labels": {
      "token-labs/metrics": "flint"
    }
  },
  "spec": {
    "clusterIP": "10.97.29.248",
    "clusterIPs": [
      "10.97.29.248"
    ],
    "internalTrafficPolicy": "Cluster",
    "ipFamilies": [
      "IPv4"
    ],
    "ipFamilyPolicy": "SingleStack",
    "ports": [
      {
        "name": "http",
        "port": 8000,
        "protocol": "TCP",
        "targetPort": "http"
      }
    ],
    "selector": {
      "token-labs/model-id": "flint-nvfp4",
      "token-labs/slot": "green"
    },
    "sessionAffinity": "None",
    "type": "ClusterIP"
  }
